<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dcamacho.todoist-pull</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-c</string>
        <string>/usr/bin/python3 /Users/dcamacho/Documents/pandora/.scripts/todoist_pull.py --if-stale</string>
    </array>
    <!-- Self-healing schedule: fire at login/wake and every 30 min. The script's
         --if-stale guard no-ops when today's snapshot already exists, so this is
         cheap and it catches up the moment the Mac wakes (fixing missed 06:20s). -->
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>1800</integer>
    <key>StandardOutPath</key>
    <string>/Users/dcamacho/Documents/pandora/.scripts/todoist_pull.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/dcamacho/Documents/pandora/.scripts/todoist_pull.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
    </dict>
</dict>
</plist>
